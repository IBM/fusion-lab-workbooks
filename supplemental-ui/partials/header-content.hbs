<script>
  (function () {
    var pdfMap = {
      'backup-restore': 'ibm-fusion-backup-restore-guide.pdf',
      'ocp-virt': 'ibm-fusion-ocp-virt-guide.pdf',
      'hcp': 'ibm-fusion-hcp-guide.pdf',
      'rdr': 'ibm-fusion-rdr-guide.pdf',
      'fusion-foundations': 'ibm-fusion-demo-guide.pdf',
      'fusion-access': 'ibm-fusion-demo-guide.pdf',
      'getting-started': 'ibm-fusion-demo-guide.pdf'
    };

    var path = window.location.pathname;
    var pdf = 'ibm-fusion-demo-guide.pdf'; // default

    for (var section in pdfMap) {
      if (path.includes('/' + section + '/')) {
        pdf = pdfMap[section];
        break;
      }
    }

    var btn = document.getElementById('download-pdf-btn');
    if (btn) {
      btn.href = '/pdf/' + pdf;
      var label = pdf.replace('ibm-fusion-', '').replace('-guide.pdf', '').replace('.pdf', '');
      btn.textContent = 'Download ' + label + ' PDF';
    }
  })();
</script>